{
  "name": "crud_ajuptel_inscripciones",
  "version": "1.0.0",
  "description": "CRUD de inscripciones AJUPTEL Carabobo",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --target node18-win-x64 --output crud-v2.exe"
  },
  "dependencies": {
